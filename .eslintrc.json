{
  "env": {
    "browser": true,
    "es2021": true,
    "react-native/react-native": true
  },
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "settings": {
    "react": {
      "version": "detect"
    }
  },
  "extends": [
    "eslint:recommended",
    "plugin:react/recommended",
    "plugin:react-native/all",
    "plugin:prettier/recommended"
  ],
  "plugins": [
    "react",
    "react-native",
    "prettier",
    "security"
  ],
  "rules": {
    "react/prop-types": "off",
    "react/react-in-jsx-scope": "off",
    
    // Optional: disable these if you don't want style warnings
    "react-native/no-color-literals": "off",
    "react-native/sort-styles": "off"
  }
}